{
  "providers": [
    {
      "id": "codex",
      "name": "Codex",
      "defaultPath": "~/.codex",
      "binary": "codex",
      "requiresPath": true,
      "wakeup": true,
      "discoverLocal": true
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "defaultPath": "~/.claude",
      "binary": "claude",
      "requiresPath": true,
      "wakeup": true,
      "discoverLocal": true
    },
    {
      "id": "antigravity",
      "name": "Antigravity",
      "apiGuidance": {
        "hint": "agy 自定义端点使用 Gemini 协议：在 CLI settings.json 设置 modelProvider=gemini，并在启动环境提供 GEMINI_API_KEY 和 GOOGLE_GEMINI_BASE_URL。OpenAI 兼容服务可通过官方 Python SDK 的 LocalOpenAIAgentConfig 使用。",
        "url": "https://www.antigravity.google/docs/install?tab=cli",
        "sdkUrl": "https://www.antigravity.google/docs/sdk/local-models"
      },
      "defaultPath": "~/.gemini/antigravity-cli",
      "binary": "agy",
      "requiresPath": false,
      "wakeup": true,
      "discoverLocal": true
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "defaultPath": "",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": false
    },
    {
      "id": "zcode",
      "name": "ZCode",
      "defaultPath": "~/.zcode",
      "binary": "zcode",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "从对应地区的 Z.ai / 智谱账户获取 Coding Plan API Key。",
        "modes": {
          "global": "Z.ai 国际版 API Key",
          "cn": "智谱中国版 API Key"
        },
        "loginUrl": "https://zcode.z.ai/en/docs/configuration"
      }
    },
    {
      "id": "qoder",
      "name": "Qoder",
      "defaultPath": "~/.qoder",
      "binary": "qodercli",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "CLI 登录直接查询当前账户 Credits，无需复制令牌；请先运行 qodercli login。也可使用对应站点 Cookie，旧中国站与 qoder.cn 新账户不互通。",
        "modes": {
          "cli": "本机 Qoder CLI 登录",
          "global": "qoder.com Cookie",
          "cn-legacy": "qoder.com.cn 旧站点 Cookie"
        },
        "loginUrl": "https://qoder.com/account/usage"
      }
    },
    {
      "id": "grok",
      "name": "Grok",
      "defaultPath": "~/.grok",
      "binary": "grok",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "订阅：运行 grok login，从 ~/.grok/auth.json 复制账户 key。API 余额：填写 Management API Key 和 Team ID。",
        "modes": {
          "subscription": "Grok 订阅登录令牌",
          "api": "xAI API 余额"
        },
        "loginUrl": "https://grok.com"
      }
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "apiGuidance": {
        "hint": "Cursor CLI 的 CURSOR_API_KEY 使用 Cursor 账户生成的用户 API Key。--endpoint / CURSOR_API_ENDPOINT 指向兼容 Cursor 服务协议的端点，包含账户密钥交换；普通 OpenAI 兼容模型地址无法直接替代。模型请通过 /model 选择。",
        "label": "CLI 登录与 API Key 说明",
        "url": "https://cursor.com/docs/cli/reference/authentication",
        "configurationUrl": "https://cursor.com/docs/cli/reference/configuration"
      },
      "defaultPath": "~/.cursor",
      "binary": "agent",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "从 Cursor 用量页复制含 WorkosCursorSessionToken 的请求 Cookie。",
        "modes": {
          "session": "Cursor 会话 Cookie"
        },
        "loginUrl": "https://cursor.com/dashboard"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "defaultPath": "~/.local/share/opencode",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "Go 使用 API Key，或 Console Cookie 与 Workspace ID 查询 Go / Zen 余额。外部订阅请连接对应服务商。",
        "modes": {
          "go": "Go API Key",
          "console": "Console Cookie / Workspace"
        },
        "loginUrl": "https://opencode.ai/console"
      }
    },
    {
      "id": "kimi",
      "name": "Kimi Code",
      "defaultPath": "~/.kimi-code",
      "binary": "kimi",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "使用 Kimi Code 订阅的 API Key 或有效访问令牌；Moonshot 开放平台 Key 与自建模型不提供此订阅限额。请选择凭据对应地区。",
        "modes": {
          "cn": "Kimi Code 中国版 API Key / 访问令牌",
          "global": "Kimi Code 国际版 API Key / 访问令牌"
        },
        "loginUrl": "https://www.kimi.com/code/console"
      }
    },
    {
      "id": "deepseek-harness",
      "name": "DeepSeek Harness",
      "defaultPath": "~/.dsh",
      "binary": "dsh",
      "requiresPath": true,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "仅用于 Harness 的 DeepSeek 官方 API 后端：输入该后端的 API Key 查询余额。自建及其他第三方模型不共用此余额。",
        "modes": {
          "api": "DeepSeek 官方 API 余额"
        },
        "loginUrl": "https://platform.deepseek.com/usage"
      }
    },
    {
      "id": "codebuddy",
      "name": "CodeBuddy",
      "defaultPath": "~/.codebuddy",
      "binary": "codebuddy",
      "requiresPath": true,
      "wakeup": false,
