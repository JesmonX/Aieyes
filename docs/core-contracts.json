{
  "providers": [
    {
      "id": "codex",
      "name": "Codex",
      "defaultPath": "~/.codex",
      "binary": "codex",
      "requiresPath": true,
      "wakeup": true,
      "discoverLocal": true
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "defaultPath": "~/.claude",
      "binary": "claude",
      "requiresPath": true,
      "wakeup": true,
      "discoverLocal": true
    },
    {
      "id": "antigravity",
      "name": "Antigravity",
      "defaultPath": "~/.gemini/antigravity-cli",
      "binary": "agy",
      "requiresPath": false,
      "wakeup": true,
      "discoverLocal": true
    },
    {
      "id": "deepseek",
      "name": "DeepSeek",
      "defaultPath": "",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": false
    },
    {
      "id": "zcode",
      "name": "ZCode",
      "defaultPath": "~/.aieyes/imports/zcode",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": false,
      "subscription": {
        "hint": "从对应地区的 Z.ai / 智谱账户获取 Coding Plan API Key。",
        "modes": {
          "global": "Z.ai 国际版 API Key",
          "cn": "智谱中国版 API Key"
        },
        "loginUrl": "https://zcode.z.ai/en/docs/configuration"
      }
    },
    {
      "id": "qoder",
      "name": "Qoder",
      "defaultPath": "~/.aieyes/imports/qoder",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": false,
      "subscription": {
        "hint": "复制对应站点的用量 Cookie。旧中国站与 qoder.cn 新账户不互通。",
        "modes": {
          "global": "qoder.com Cookie",
          "cn-legacy": "qoder.com.cn 旧站点 Cookie"
        },
        "loginUrl": "https://qoder.com/account/usage"
      }
    },
    {
      "id": "grok",
      "name": "Grok",
      "defaultPath": "~/.aieyes/imports/grok",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": false,
      "subscription": {
        "hint": "订阅：运行 grok login，从 ~/.grok/auth.json 复制账户 key。API 余额：填写 Management API Key 和 Team ID。",
        "modes": {
          "subscription": "Grok 订阅登录令牌",
          "api": "xAI API 余额"
        },
        "loginUrl": "https://grok.com"
      }
    },
    {
      "id": "cursor",
      "name": "Cursor",
      "defaultPath": "~/.aieyes/imports/cursor",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": false,
      "subscription": {
        "hint": "从 Cursor 用量页复制含 WorkosCursorSessionToken 的请求 Cookie。",
        "modes": {
          "session": "Cursor 会话 Cookie"
        },
        "loginUrl": "https://cursor.com/dashboard"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "defaultPath": "~/.local/share/opencode",
      "binary": "",
      "requiresPath": false,
      "wakeup": false,
      "discoverLocal": true,
      "subscription": {
        "hint": "Go 使用 API Key，或 Console Cookie 与 Workspace ID 查询 Go / Zen 余额。外部订阅请连接对应服务商。",
        "modes": {
          "go": "Go API Key",
          "console": "Console Cookie / Workspace"
        },
        "loginUrl": "https://opencode.ai/console"
      }
    },
    {
      "id": "custom",
      "name": "自定义",
      "defaultPath": "~/.aieyes",
      "binary": "",
      "requiresPath": true,
      "wakeup": false,
      "discoverLocal": false
    }
  ],
  "windows": {
    "fiveHour": 300,
    "week": 10080
  },
  "filesystems": {
    "excludedTypes": [
      "tmpfs",
      "devtmpfs",
      "squashfs",
      "overlay",
      "proc",
      "procfs",
      "sysfs",
      "devfs",
      "autofs",
      "cgroup",
      "cgroup2"
    ],
    "excludedPaths": [
      "/snap",
      "/var/lib/snapd/snap",
      "/run",
      "/efi",
      "/boot/efi",
      "/dev",
      "/proc",
      "/sys",
      "/system/volumes/preboot",
      "/system/volumes/vm",
      "/system/volumes/update",
      "/system/volumes/xarts",
      "/system/volumes/iscpreboot",
      "/system/volumes/hardware"
    ]
  },
