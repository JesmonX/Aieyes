  "cases": [
    {
      "name": "legacy configuration without agents",
      "agents": [],
      "hosts": [
        {
          "id": "online",
          "enabled": true
        },
        {
          "id": "paused",
          "enabled": false
        }
      ],
      "expectedEnabled": [
        "local",
        "remote",
        "claude",
        "balance",
        "custom"
      ],
      "expectedUsage": [
        "local",
        "remote",
        "claude",
        "custom"
      ]
    },
    {
      "name": "enabled agent on selected machines",
      "agents": [
        {
          "provider": "codex",
          "enabled": true,
          "machineIds": [
            "local",
            "online"
          ]
        }
      ],
      "hosts": [
        {
          "id": "online",
          "enabled": true
